{
  "name": "gen-stage-vscode",
  "displayName": "Gen-Stage",
  "description": "Sân khấu Gen-Stage trong tab editor + chatroom cột phải (spike V0).",
  "version": "0.0.1",
  "publisher": "gen-labs",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "genStage.moSanKhau",
        "title": "Mở sân khấu",
        "category": "Gen-Stage"
      },
      {
        "command": "genStage.batDichVu",
        "title": "Bật bridge + sân khấu",
        "category": "Gen-Stage"
      },
      {
        "command": "genStage.tatDichVu",
        "title": "Tắt dịch vụ do VS Code bật",
        "category": "Gen-Stage"
      },
      {
        "command": "genStage.xemLog",
        "title": "Xem nhật ký",
        "category": "Gen-Stage"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "genStage",
          "title": "Gen-Stage",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "genStage": [
        {
          "type": "webview",
          "id": "genStage.chatroom",
          "name": "Chatroom"
        }
      ]
    },
    "configuration": {
      "title": "Gen-Stage",
      "properties": {
        "genStage.root": {
          "type": "string",
          "default": "",
          "description": "Thư mục repo Gen-Stage (có bridge/server.ts). Bỏ trống = tự tìm trong workspace, rồi thư mục cha của extension."
        },
        "genStage.bridgePort": {
          "type": "number",
          "default": 8787,
          "description": "Cổng ws của bridge."
        },
        "genStage.ttsPort": {
          "type": "number",
          "default": 8788,
          "description": "Cổng HTTP giọng nói (TTS) của bridge."
        },
        "genStage.devPort": {
          "type": "number",
          "default": 5173,
          "description": "Cổng vite (app sân khấu)."
        },
        "genStage.tuBat": {
          "type": "boolean",
          "default": true,
          "description": "Cổng chưa có ai nghe thì tự bật `pnpm bridge` + vite (127.0.0.1). Tiến trình có sẵn thì luôn dùng lại, không bao giờ tắt."
        },
        "genStage.pnpm": {
          "type": "string",
          "default": "pnpm",
          "description": "Lệnh pnpm (đường dẫn tuyệt đối nếu PATH của VS Code không thấy nvm/corepack)."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../node_modules/typescript/bin/tsc -p tsconfig.web.json",
    "check": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node ../node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "test": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node ../node_modules/typescript/bin/tsc -p tsconfig.web.json && node --test test/*.test.mjs"
  }
}
