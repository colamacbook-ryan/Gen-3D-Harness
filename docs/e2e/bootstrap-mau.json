   "cmd": "script.run",
   "group": "script",
   "desc": "Chạy một chuỗi bước. Mỗi bước là một lệnh, hoặc {\"wait\":ms} / {\"waitFor\":\"tên sự kiện\"}. Ghi chú: \"parallel\" bắn cùng lúc, nhưng nhiều bước trên CÙNG một actor vẫn tuần tự vì xếp hàng theo actor.",
   "params": [
    {
     "name": "steps",
     "type": "json",
     "desc": "Mảng JSON các bước",
     "required": true,
     "default": "[{\"cmd\":\"actor.moveTo\",\"args\":{\"actor\":\"gen\",\"to\":\"ban-2\"}},{\"waitFor\":\"actor.arrived\"},{\"cmd\":\"actor.say\",\"args\":{\"actor\":\"gen\",\"text\":\"Tới rồi Sếp!\"}}]"
    },
    {
     "name": "mode",
     "type": "enum",
     "desc": "Chạy lần lượt hay cùng lúc",
     "required": false,
     "values": [
      "sequential",
      "parallel"
     ],
     "default": "sequential"
    }
   ],
   "events": [
    "script.step",
    "script.stepError",
    "script.done",
    "script.stopped"
   ],
   "example": {
    "cmd": "script.run",
    "args": {
     "steps": [
      {
       "cmd": "actor.moveTo",
       "args": {
        "actor": "gen",
        "to": "ban-2"
       }
      },
      {
       "waitFor": "actor.arrived"
      },
      {
       "cmd": "actor.express",
       "args": {
        "actor": "gen",
        "expression": "happy"
       }
      },
      {
       "cmd": "actor.say",
       "args": {
        "actor": "gen",
        "text": "Sếp ơi, test xanh rồi!"
       }
      }
     ],
     "mode": "sequential"
    }
   }
  },
