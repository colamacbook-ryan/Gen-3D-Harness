     "required": false
    },
    {
     "name": "to",
     "type": "target",
     "desc": "Nói VỚI AI: \"camera\" (mặc định — nói với Sếp đang xem qua màn hình) hoặc id một actor khác. Quyết định người nói quay mặt về đâu và ai lắng nghe",
     "required": false,
     "values": [
      "camera",
      "cursor",
      "owner",
      "gen",
      "ban-dieu-khien",
      "ban-1",
      "ban-2",
      "ghe-1",
      "ghe-2",
      "buc-trung-tam",
      "cua",
      "ke-module",
      "sofa",
      "ban-an",
      "bep",
      "cua-so",
      "may-tinh",
      "tivi"
     ],
     "tuDo": true,
     "default": "camera"
    },
    {
