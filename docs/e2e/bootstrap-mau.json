{
 "commands": [
  {
   "cmd": "stage.bootstrap",
   "group": "stage",
   "desc": "Toàn bộ sách hướng dẫn: version, mọi lệnh + mô tả + ví dụ, danh sách actor/place/prop/clip/biểu cảm. Agent gọi đầu tiên.",
   "params": [],
   "example": {
    "cmd": "stage.bootstrap"
   }
  },
  {
   "cmd": "stage.describe",
   "group": "stage",
   "desc": "Trạng thái sân khấu bằng số: actor ở đâu, làm gì, khoảng cách tới mọi place",
   "params": [],
   "example": {
    "cmd": "stage.describe"
   }
  },
  {
   "cmd": "stage.hear",
   "group": "stage",
   "desc": "Đánh dấu một câu là Boss NÓI (không phải gõ) từ nguồn ngoài trình duyệt (extension, sidecar STT — qua ws bridge, MCP của não bị chặn): bắn đúng một user.text + một user.speech (confidence, goiGen). Chữ đi qua sổ từ nhà như đường mic (\"ghen ơi\" → \"Gen ơi\"). Chạy actor.say (interrupt) lên nhân vật controlledBy \"owner\" nên user.text vẫn chỉ có một nguồn. Chỉ dành cho Boss/ngoại vi (ws bridge): MCP của não bị chặn lệnh này",
   "params": [
    {
     "name": "text",
     "type": "text",
     "desc": "Câu đã nhận dạng",
     "required": true
    },
    {
     "name": "to",
     "type": "target",
     "desc": "Nói VỚI AI (như actor.say): \"camera\" (mặc định) hoặc id một actor",
     "required": false,
     "values": [
      "camera",
      "cursor",
      "owner",
      "gen",
      "ban-dieu-khien",
      "ban-1",
      "ban-2",
      "ghe-1",
      "ghe-2",
      "buc-trung-tam",
      "cua",
      "ke-module",
      "sofa",
      "ban-an",
      "bep",
      "cua-so",
      "may-tinh",
      "tivi"
     ],
     "tuDo": true
    },
    {
     "name": "confidence",
     "type": "number",
     "desc": "Độ tin cậy nhận dạng 0..1",
     "required": false,
     "default": 1
    },
    {
     "name": "durationMs",
     "type": "number",
     "desc": "Thời gian nhận dạng (ms)",
     "required": false,
     "default": 0
    }
   ],
   "events": [
    "user.text",
    "user.speech",
    "actor.sayStart",
    "actor.sayDone",
    "cmd.queued"
   ],
   "example": {
    "cmd": "stage.hear",
    "args": {
     "text": "Gen ơi, dựng connector Baserow",
     "confidence": 0.9
    }
   }
  },
  {
   "cmd": "stage.notice",
   "group": "stage",
   "desc": "V3 — GIÁC QUAN IDE: báo sân khấu một việc thật vừa xảy ra trong IDE của Sếp (lưu file, lỗi biên dịch, test/task pass/fail, git commit) → bắn sự kiện ide.event để phản xạ + não phản ứng. Không chiếm actor. Chỉ mang tóm tắt + số đếm/tên ngắn, KHÔNG nội dung file. Chỉ dành cho Boss/ngoại vi (extension VS Code qua ws bridge): MCP của não bị chặn lệnh này",
   "params": [
    {
     "name": "kind",
     "type": "enum",
     "desc": "Loại việc",
     "required": true,
     "values": [
      "save",
      "diag",
      "test",
      "task",
      "git"
     ]
    },
    {
     "name": "summary",
     "type": "text",
     "desc": "Tóm tắt một dòng (≤ 200 ký tự)",
     "required": true
    },
    {
     "name": "level",
     "type": "enum",
     "desc": "Tốt/xấu",
     "required": false,
     "values": [
      "info",
      "good",
      "bad"
     ],
     "default": "info"
    },
    {
     "name": "data",
     "type": "json",
     "desc": "Object phẳng chỉ số đếm/tên ngắn (vd {\"errors\":3}, {\"files\":[\"a.ts\"]}) — không nội dung",
     "required": false
    }
   ],
   "events": [
    "ide.event"
   ],
   "example": {
    "cmd": "stage.notice",
    "args": {
     "kind": "test",
     "level": "bad",
     "summary": "Test \"unit\" fail (mã 1)"
    }
   }
  },
